# Copia este archivo a ".env" (o exporta estas variables en tu servidor) y complétalo.
# Nunca subas el archivo ".env" real a un repositorio público.

# Clave secreta de Flask (usada para firmar la sesión de login). Genera una única y larga:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-en-produccion

# Puerto en el que corre la app
PORT=5000

# 1 = modo desarrollo (recarga automática, errores detallados). 0 = producción.
FLASK_DEBUG=1

# --- WhatsApp (opcional, solo si activas el envío automático / chatbot) ---
# Estos también se pueden configurar desde el panel: Configuración → WhatsApp
# WA_CLOUD_TOKEN=
# WA_CLOUD_PHONE_ID=

# --- Inicio de sesión con Google (opcional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
